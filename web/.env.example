# ---------------------------------------------------------------------------
# NEXORA — environment variables. Copy this file to `web/.env` and fill in.
# NEVER commit the real .env (it is gitignored).
# ---------------------------------------------------------------------------

# Neon PostgreSQL. Use the POOLED connection string (has "-pooler" in the host)
# for the app, and the DIRECT (non-pooled) string for migrations.
# Both include ?sslmode=require. Get them from the Neon dashboard → Connect.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Step 2 — Authentication (Auth.js / NextAuth v5) ----
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Optional in dev (auto-detected). Set explicitly in production, e.g. your domain.
# AUTH_URL="http://localhost:3000"

# Public site URL — used for SEO metadata, sitemap, Open Graph and email links.
# Set to your real domain in production (e.g. https://nexora.example.com).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Step 11 — Resend (order confirmation emails) ----
# Free API key from https://resend.com → API Keys. Server-only; never exposed.
RESEND_API_KEY=""
# During dev, Resend's test sender only delivers to your own signup email.
# In production use a verified domain sender, e.g. "NEXORA <orders@yourdomain.com>".
EMAIL_FROM="NEXORA <onboarding@resend.dev>"

# Optional — Google OAuth. If both are blank, the Google button is simply not
# shown and email/password still works.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Set to "true" to show the "Continue with Google" button once the above are set.
# NEXT_PUBLIC_GOOGLE_ENABLED="false"

# ---- Step 3 — Cloudinary (real image uploads) ----
# From your Cloudinary dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Step 5 — Razorpay (test mode) ----
# From Razorpay Dashboard → Settings → API Keys (in TEST mode).
# Leave blank to use Cash on Delivery only; online payment stays hidden/guarded.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
