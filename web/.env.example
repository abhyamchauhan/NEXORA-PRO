# ---------------------------------------------------------------------------
# NEXORA — environment variables. Copy this file to `web/.env` and fill in.
# NEVER commit the real .env (it is gitignored).
# ---------------------------------------------------------------------------

# Neon PostgreSQL. Use the POOLED connection string (has "-pooler" in the host)
# for the app, and the DIRECT (non-pooled) string for migrations.
# Both include ?sslmode=require. Get them from the Neon dashboard → Connect.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Added in later steps (leave blank for Step 1) ----
# Step 2 — NextAuth
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="run: openssl rand -base64 32"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Step 3 — Cloudinary (image uploads)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Step 5 — Razorpay (test mode)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# NEXT_PUBLIC_RAZORPAY_KEY_ID=""
